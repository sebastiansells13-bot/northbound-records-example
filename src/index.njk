---
layout: layouts/page.njk
title: Home
eleventyNavigation:
  key: Home
  order: 1
---
<section class="hero">
  <div class="wrap">
    <h1>{{ business.name }}</h1>
    <p>{{ business.tagline }}</p>
    <a href="/releases/" class="btn">Hear the Catalog</a>
    <a href="/tour/" class="btn-outline" style="margin-left:0.75rem;">Upcoming Shows</a>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-heading">
      <h2>Latest Releases</h2>
      <p>// six records, three bands, one label</p>
    </div>
    <div class="release-grid">
      {% for r in releases.list | head(3) %}
      <div class="release-card">
        <div class="release-card__art" style="background:{{ r.bg }}; color:{{ r.fg }};">{{ r.mono }}</div>
        <div class="release-card__body">
          <h3>{{ r.title }}</h3>
          <p>{{ r.artist }} — {{ r.format }}, {{ r.year }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-heading">
      <h2>Next Show</h2>
      <p>// full dates on the Tour page</p>
    </div>
    <ul class="tour-list">
      {% for show in tour.list | head(1) %}
      <li class="tour-row">
        <span class="tour-row__date">{{ show.date | readableDateString }}</span>
        <span>
          <span class="tour-row__venue">{{ show.venue }} — {{ show.artist }}</span><br>
          <span class="tour-row__city">{{ show.city }}</span>
        </span>
        <span class="tour-row__countdown" data-countdown="{{ show.date }}">—</span>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
