<!doctype html>
<html lang="{{ metadata.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ business.name or metadata.title }}</title>
  <meta name="description" content="{{ description or business.tagline or metadata.description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      NEW EP OUT NOW &nbsp;//&nbsp; TOUR DATES ANNOUNCED &nbsp;//&nbsp; ALL AGES SHOWS &nbsp;//&nbsp; NEW EP OUT NOW &nbsp;//&nbsp; TOUR DATES ANNOUNCED &nbsp;//&nbsp; ALL AGES SHOWS &nbsp;//&nbsp;
    </div>
  </div>
  {% include "components/header.njk" %}
  <main>
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
  <script src="/js/tour-countdown.js"></script>
</body>
</html>
